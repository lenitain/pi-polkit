{
  "name": "pi-polkit",
  "version": "0.2.0",
  "description": "Redirect sudo, doas and su to pkexec in Pi via PATH shims, so the desktop polkit agent handles authentication",
  "type": "module",
  "pi": {
    "extensions": ["./index.ts"]
  },
  "files": [
    "index.ts",
    "polkit-redirect.ts",
    "polkit-shims.ts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "prepublishOnly": "npm run check && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": ["pi-package", "pi-extension", "sudo", "doas", "su", "pkexec", "polkit", "security"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenitain/pi-polkit.git"
  },
  "bugs": {
    "url": "https://github.com/lenitain/pi-polkit/issues"
  }
}
